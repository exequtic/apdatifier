#!/usr/bin/env bash

# Keep desktop entry discovery independent from the terminal's launch arguments.
declare -A terminalFiles
declare -A terminalArgs=(
    [alacritty]=-e [foot]=-e [ghostty]=-e [gnome-terminal]=--
    [kitty]=-e [konsole]=-e [kwi]=-e [lxterminal]=-e [ptyxis]=--
    [terminator]=-x [tilix]=-e [wezterm]=-e [xterm]=-e [uxterm]=-e
)

readKdeDefault() {
    defaultId=$(kreadconfig6 --file kdeglobals --group General --key TerminalService)
    defaultExec=$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication)
    [[ -n $defaultId || -n $defaultExec ]] || defaultId=org.kde.konsole.desktop
}

findTerminalEntries() {
    local wanted=$1
    local dir root file id key value categories type hidden noDisplay tryExec onlyShow notShow
    local -a dataDirs
    local -A seen
    IFS=: read -ra dataDirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" "${dataDirs[@]}"; do
        root=$dir/applications
        [[ $dir = /* && -d $root ]] || continue
        while IFS= read -r -d '' file; do
            id=${file#"$root"/}
            id=${id//\//-}
            [[ ! $wanted || $id == "$wanted" ]] || continue
            [[ ${seen[$id]} ]] && continue
            seen[$id]=1
            categories= type= hidden= noDisplay= tryExec= onlyShow= notShow=
            while IFS='=' read -r key value; do
                case "$key" in
                    '[Desktop Entry]') ;;
                    '['*) break ;;
                    Categories) categories=$value ;;
                    Type) type=$value ;;
                    Hidden) hidden=$value ;;
                    NoDisplay) noDisplay=$value ;;
                    TryExec) tryExec=$value ;;
                    OnlyShowIn) onlyShow=$value ;;
                    NotShowIn) notShow=$value ;;
                esac
            done < "$file"
            [[ $type == Application && $hidden != true ]] || continue
            [[ ! $tryExec ]] || command -v "$tryExec" >/dev/null || continue
            if [[ $id != "$defaultId" ]]; then
                [[ ";$categories;" == *";TerminalEmulator;"* && $noDisplay != true ]] || continue
                [[ ! $onlyShow || ";$onlyShow;" == *";KDE;"* ]] || continue
                [[ ";$notShow;" != *";KDE;"* ]] || continue
            fi
            terminalFiles[$id]=$file
            [[ ! $wanted ]] || return
        done < <(find "$root" -name '*.desktop' \( -type f -o -type l \) -print0 | sort -z)
    done
}

readDesktopKey() {
    kreadconfig6 --file "$file" --group 'Desktop Entry' --key "$1" "${@:2}"
}

splitCommand() {
    # xargs parses quotes and escapes without evaluating shell syntax.
    mapfile -d '' -t command < <(
        if xargs -r printf '%s\0' <<< "$1" 2>/dev/null; then
            printf '%s\0' ok
        else
            printf '%s\0' invalid
        fi
    )
    [[ ${command[-1]} == ok && ${#command[@]} -gt 1 && ${command[0]} ]] || return 1
    unset 'command[-1]'
}

desktopCommand() {
    local word
    local -a expanded=()
    splitCommand "$1" || return 1
    for word in "${command[@]}"; do
        case "$word" in
            %f|%F|%u|%U|%d|%D|%n|%N|%v|%m|@@|@@u|--file-forwarding) continue ;;
            %i) [[ ! $icon ]] || expanded+=(--icon "$icon"); continue ;;
        esac
        # Preserve escaped percent signs while handling the remaining field codes.
        word=${word//%%/$'\x1f'}
        word=${word//%c/"$name"}
        word=${word//%k/"$file"}
        word=${word//$'\x1f'/%}
        expanded+=("$word")
    done
    command=("${expanded[@]}")
}

resolveCommand() {
    local option word permissions app= arch= branch= executable
    if [[ ! ${command[0]} ]] || ! command -v "${command[0]}" >/dev/null; then
        error="The terminal executable is unavailable."
        return
    fi
    executable=${command[0]##*/}
    if [[ $executable == flatpak && ${command[1]} == run ]]; then
        executable=
        for word in "${command[@]:2}"; do
            case "$word" in
                --command=*) executable=${word#*=} ;;
                --arch=*) arch=$word ;;
                --branch=*) branch=${word#*=} ;;
                -*) ;;
                *) app=$word; break ;;
            esac
        done
        [[ $executable ]] || executable=${app##*.}
    fi
    legacy=${app:+flatpak://$app/}$executable

    if [[ $executable == yakuake ]]; then
        yakuake=true
        return
    fi

    # The sentinel distinguishes a missing key from an explicitly empty argument.
    option=missing
    if [[ $file ]]; then
        option=$(readDesktopKey TerminalArgExec --default missing)
        [[ $option != missing ]] || option=$(readDesktopKey X-TerminalArgExec --default missing)
    fi
    if [[ $option == missing ]]; then
        option=${terminalArgs[$executable]}
        if [[ ! $option ]]; then
            printf -v example '%q ' "${command[@]}"
            example+='%s'
            error="This terminal needs a custom launch command."
            return
        fi
    fi

    launch=("${command[@]}")
    [[ ! $option ]] || launch+=("$option")
    if [[ $app ]]; then
        if ! permissions=$(flatpak info --show-permissions ${arch:+"$arch"} "$app" ${branch:+"$branch"} 2>/dev/null); then
            error="The Flatpak $app is unavailable."
        elif ! grep -Fxq 'org.freedesktop.Flatpak=talk' <<< "$permissions"; then
            error="This Flatpak needs permission to run commands on the host."
        elif [[ $executable != kwi ]]; then
            # Kwi already starts its command on the host.
            launch+=(flatpak-spawn --host)
        fi
    fi
}

resolveDesktop() {
    file=${terminalFiles[$1]}
    if [[ ! $file ]]; then
        name=$1
        error="The selected terminal is no longer installed."
        return
    fi
    name=$(readDesktopKey Name --default "$1")
    icon=$(readDesktopKey Icon)
    if desktopCommand "$(readDesktopKey Exec)"; then
        resolveCommand
    else
        error="The desktop entry has no usable launch command."
    fi
}

resolveTerminal() {
    local ref app executable arch branch
    local -a command
    file= name= icon= legacy= error= example= yakuake=
    launch=() suffix=()

    case "$1" in
        custom)
            if ! splitCommand "$2" || [[ ${command[0]} == '%s' ]]; then
                error="Enter a terminal command with one standalone %s argument."
                return
            fi
            local word marker=
            for word in "${command[@]}"; do
                if [[ $word == '%s' && $marker ]]; then
                    error="Use %s only once."
                    return
                elif [[ $word == '%s' ]]; then
                    marker=true
                elif [[ $marker ]]; then
                    suffix+=("$word")
                else
                    launch+=("$word")
                fi
            done
            if [[ ! $marker ]]; then
                error="Enter a terminal command with one standalone %s argument."
            elif ! command -v "${launch[0]}" >/dev/null; then
                error="The custom terminal executable is unavailable."
            fi
            ;;
        ''|kde-default)
            if [[ $defaultId ]]; then
                resolveDesktop "$defaultId"
            elif splitCommand "$defaultExec"; then
                name=${command[0]##*/}
                resolveCommand
            else
                error="KDE has no available default terminal."
            fi
            ;;
        *.desktop) resolveDesktop "$1" ;;
        flatpak://*)
            ref=${1#flatpak://}
            if ref=$(flatpak info --show-ref "${ref%/*}" 2>/dev/null); then
                IFS=/ read -r _ app arch branch <<< "$ref"
                executable=${1##*/}
                command=(flatpak run "--arch=$arch" "--branch=$branch" "--command=$executable" "$app")
                resolveCommand
            else
                error="The selected Flatpak terminal is no longer installed."
            fi
            ;;
        *) command=("$1"); resolveCommand ;;
    esac
}

listTerminals() {
    local id file name icon legacy error example yakuake
    local -a launch suffix
    readKdeDefault
    findTerminalEntries
    resolveTerminal kde-default
    printf '%s\0' kde-default "$name" "$icon" '' "$error" "$example"
    for id in "${!terminalFiles[@]}"; do
        resolveTerminal "$id"
        printf '%s\0' "$id" "$name" "$icon" "$legacy" "$error" "$example"
    done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    listTerminals
fi
