#!/usr/bin/env bash

source "$(dirname "$0")/utils"

selection=$1
template=$2
task=$3
shift 3

source "$scriptDir/terminal-registry"
case "$selection" in
    ""|kde-default)
        readKdeDefault
        [[ ! $defaultId ]] || findTerminalEntries "$defaultId"
        ;;
    *.desktop) findTerminalEntries "$selection" ;;
esac
resolveTerminal "$selection" "$template"
if [[ $error ]]; then
    printf '%s\n' "$error" >&2
    exit 1
fi

if [[ $task == "test" ]]; then
    payload=(bash -c 'printf "%s\n" "$1"; read -r' bash "$1")
else
    payload=(bash "$scriptDir/$task" "$@")
fi

session=
if [[ $yakuake ]]; then
    if ! session=$(qdbusCMD sessions addSession) || [[ ! $session =~ ^[0-9]+$ ]]; then
        echo "Could not create a Yakuake session. Open Yakuake and try again." >&2
        exit 1
    fi
    visible=$(qdbusCMD MainWindow_1 org.qtproject.Qt.QWidget.visible)
    qdbusCMD tabs org.kde.yakuake.setTabTitle "$session" "${task^}"
    if [[ $task != "test" ]]; then
        payload=(env "APDATIFIER_YAKUAKE_SESSION=$session" "${payload[@]}")
    fi
fi

if [[ $task != "test" && $tmuxSession == "true" ]] && command -v tmux >/dev/null; then
    sess=Apdatifier
    name="${task^}"
    if ! tmux has-session -t "=$sess" 2>/dev/null; then
        tmux new-session -d -s "$sess" -n "$name" "${payload[@]}" || exit 1
    elif ! tmux list-windows -t "=$sess" -F '#{window_name}' | grep -Fxq "$name"; then
        tmux new-window -t "$sess:" -n "$name" "${payload[@]}" || exit 1
    fi
    payload=(tmux attach-session -t "$sess" \; select-window -t "$sess:$name")
fi

if [[ $yakuake ]]; then
    printf -v command '%q ' "${payload[@]}"
    printf -v command 'bash -c %q' "$command"
    qdbusCMD sessions runCommandInTerminal "$session" "$command" || exit 1
    if [[ $visible == "false" ]]; then
        qdbusCMD window org.kde.yakuake.toggleWindowState
    fi
else
    exec setsid --fork --wait "${launch[@]}" "${payload[@]}" "${suffix[@]}"
fi
